# Paste into Streamlit Cloud → App settings → Secrets (or copy to .streamlit/secrets.toml locally).
# Never commit the real file.

# At least one provider key. The DEFAULT_PROVIDER is tried first; the others are automatic backups.
GEMINI_API_KEY = "your-gemini-key"
# GROQ_API_KEY = "gsk_..."
# OPENAI_API_KEY = "sk-..."
DEFAULT_PROVIDER = "gemini"

# REQUIRED on a public URL: without it anyone with the link spends your API quota and sees your history.
APP_PASSWORD = "choose-something-long"

# Persistent history (Streamlit Cloud wipes its disk on restart). Run storage/supabase_schema.sql first.
# Use the service_role key and keep it here only.
# STORAGE = "supabase"
# SUPABASE_URL = "https://xxxx.supabase.co"
# SUPABASE_KEY = "service-role-key"
